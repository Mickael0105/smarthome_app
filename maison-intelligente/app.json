{
  "expo": {
    "name": "AM'NAY",
    "slug": "amnay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/amnay-logo.png",
    "userInterfaceStyle": "dark",
    "scheme": "amnay",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.demo.amnay"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F1A",
        "foregroundImage": "./assets/amnay-logo.png"
      },
      "package": "com.demo.amnay"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/amnay-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70d38815-5b5f-4674-8bbd-3f719b4b2416"
      }
    }
  }
}
